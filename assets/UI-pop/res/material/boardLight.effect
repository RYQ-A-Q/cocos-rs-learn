CCEffect %{

techniques:

- name: colorize

  passes:

  - vert: vs:vert
    frag: fs:frag

    blendState:
      targets:

      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha


    depthStencilState:

      depthTest: false
      depthWrite: false


    rasterizerState:

      cullMode: none


    properties:

      tintColor:
        value: [1,0.8,0.2,1]
        editor:
          type: color


      tintStrength:
        value: 0.8
        editor:
          range: [0,1,0.01]

}%



// =========================
// Vertex
// =========================

CCProgram vs %{

precision highp float;

#include <cc-global>


in vec3 a_position;

in vec2 a_texCoord;

in vec4 a_color;


out vec2 uv;

out vec4 v_color;



vec4 vert()
{

    vec4 pos =
        vec4(
            a_position,
            1.0
        );


    pos =
        cc_matViewProj *
        pos;


    uv =
        a_texCoord;


    v_color =
        a_color;


    return pos;
}


}%






// =========================
// Fragment
// =========================

CCProgram fs %{

precision highp float;


#include <sprite-texture>



in vec2 uv;

in vec4 v_color;



uniform UBO
{

    vec4 tintColor;

    float tintStrength;

};





// 计算亮度
float luminance(vec3 color)
{

    return dot(
        color,
        vec3(
            0.299,
            0.587,
            0.114
        )
    );

}





vec4 frag()
{


    vec4 texColor =
        texture(
            cc_spriteTexture,
            uv
        );



    if(texColor.a < 0.001)
    {
        discard;
    }



    // =========================
    // 原图亮度
    // =========================

    float gray =
        luminance(
            texColor.rgb
        );



    // =========================
    // 泛华颜色
    // =========================

    vec3 colorized =
        gray *
        tintColor.rgb;



    // =========================
    // 混合
    // =========================

    texColor.rgb =
        mix(
            texColor.rgb,
            colorized,
            tintStrength
        );



    // =========================
    // 保留 Sprite Color
    // =========================

    texColor *= v_color;



    return texColor;

}

}%