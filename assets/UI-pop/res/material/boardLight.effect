CCEffect %{
techniques:
  - name: glow

    passes:
      - vert: vs:vert

        frag: fs:frag

        blendState:
          targets:
            - blend: true

              blendSrc: src_alpha

              blendDst: one_minus_src_alpha

        depthStencilState:
          depthTest: false

          depthWrite: false

        rasterizerState:
          cullMode: none

        properties:
          lightColor: { value: [0.2, 0.8, 1.0, 1.0], editor: { type: color } }

          lightIntensity: { value: 3.0, editor: { range: [0, 10] } }

          glowsize: { value: 0.15, editor: { range: [0, 1] } }

          pulseSpeed: { value: 2.0, editor: { range: [0, 5] } }

          isBlinking: { value: 0 }

}%


// ================= VS =================
CCProgram vs %{

precision highp float;

#include <cc-global>

#if USE_LOCAL
  
  #include <builtin/uniforms/cc-local>
  
#endif

in vec3 a_position;

in vec2 a_texCoord;

out vec2 uv;

#if USE_LOCAL
  
  in vec4 a_color;
  
  out vec4 v_color;
  
#endif

vec4 vert() {
  
  vec4 pos = vec4(a_position, 1.0);
  
  #if USE_LOCAL
    
    pos = cc_matWorld * pos;
    
    v_color = a_color;
    
  #endif
  
  pos = cc_matViewProj * pos;
  
  uv = a_texCoord;
  
  return pos;
  
}

}%


// ================= FS =================
CCProgram fs %{

precision highp float;

#include <sprite-texture>

#include <cc-global>

in vec2 uv;

uniform UBO {
  
  vec4 lightColor;
  
  float lightIntensity;
  
  float pulseSpeed;
  
  float time;
  
  float isBlinking;
  
  float glowsize;
  
};

// ===== 边缘检测 ===== 
float edgeMask(vec2 uv) {
  
  float a = texture(cc_spriteTexture, clamp(uv, vec2(0.001), vec2(0.999))).a;
  
  float l = texture(cc_spriteTexture, clamp(uv + vec2(-0.01, 0.0), vec2(0.001), vec2(0.999))).a;
  
  float r = texture(cc_spriteTexture, clamp(uv + vec2(0.01, 0.0), vec2(0.001), vec2(0.999))).a;
  
  float u = texture(cc_spriteTexture, clamp(uv + vec2(0.0, 0.01), vec2(0.001), vec2(0.999))).a;
  
  float d = texture(cc_spriteTexture, clamp(uv + vec2(0.0, - 0.01), vec2(0.001), vec2(0.999))).a;
  
  float edge = abs(a - l) + abs(a - r) + abs(a - u) + abs(a - d);
  
  return smoothstep(0.05, 0.25, edge);
  
}

vec4 frag() {
  
  vec2 safeUV = clamp(uv, vec2(0.001), vec2(0.999));
  
  vec4 texColor = texture(cc_spriteTexture, safeUV);
  
  if (texColor.a < 0.01)return texColor;
  
  vec4 o = texColor;
  
  // =============================== 
  // 🔥 核心：顺时针环形流光 
  // =============================== 
  
  vec2 p = safeUV - vec2(0.5);
  
  float angle = atan(p.y, p.x);
  
  // 0~1 
  float ang01 = (angle + 3.1415926) / 6.2831852;
  
  // 时间（允许 cc_time） 
  float t = cc_time.x * pulseSpeed;
  
  // 顺时针推进（关键） 
  float flow = fract(ang01 - t);
  
  // 边缘 
  float edge = edgeMask(safeUV);
  
  // 流光带 
  float band = smoothstep(1.0 - glowsize, 1.0, flow);
  
  // 让流光只在边缘出现 
  float finalMask = band * edge;
  
  vec3 glow = lightColor.rgb * finalMask * lightIntensity;
  
  o.rgb += glow;
  
  // 可选闪烁 
  if (isBlinking > 0.5) {
    
    float blink = sin(cc_time.x * 6.0) * 0.5 + 0.5;
    
    o.rgb *= mix(0.8, 1.2, blink);
    
  }
  
  return o;
  
}

}%