CCEffect %{
techniques:
  - name: boardLight
    passes:
      - vert: vs:vert
        frag: fs:frag

        blendState:
          targets:
            - blend: true
              blendSrc: src_alpha
              blendDst: one_minus_src_alpha

        depthStencilState:
          depthTest: false
          depthWrite: false

        rasterizerState:
          cullMode: none

        properties:

          glowColor:
            value: [0.2, 0.8, 1.0, 1.0]
            editor:
              type: color

          tintColor:
            value: [1.0, 1.0, 1.0, 1.0]
            editor:
              type: color

          outlineColor:
            value: [1.0, 1.0, 1.0, 1.0]
            editor:
              type: color

          glowStrength:
            value: 1.5
            editor:
              range: [0.0, 5.0, 0.01]

          outlineWidth:
            value: 0.008
            editor:
              range: [0.001, 0.05, 0.001]

          edgeStrength:
            value: 2.0
            editor:
              range: [0.0, 5.0, 0.01]

}%



CCProgram vs %{

precision highp float;

#include <cc-global>


#if USE_LOCAL
#include <builtin/uniforms/cc-local>
#endif


in vec3 a_position;
in vec2 a_texCoord;


#if USE_LOCAL

in vec4 a_color;

out vec4 v_color;

#endif


out vec2 uv;



vec4 vert()
{

    vec4 pos = vec4(a_position,1.0);


#if USE_LOCAL

    pos = cc_matWorld * pos;

    v_color = a_color;

#endif


    pos = cc_matViewProj * pos;


    uv = a_texCoord;


    return pos;

}

}%






CCProgram fs %{

precision highp float;


#include <sprite-texture>


in vec2 uv;



#if USE_LOCAL

in vec4 v_color;

#endif



uniform UBO
{

    // 16 byte
    vec4 glowColor;


    // 16 byte
    vec4 tintColor;


    // 16 byte
    vec4 outlineColor;



    // 16 byte
    float glowStrength;

    float outlineWidth;

    float edgeStrength;

    float padding;

};





// =====================
// 安全采样
// =====================

vec4 sampleSprite(vec2 p)
{

    return texture(
        cc_spriteTexture,
        clamp(
            p,
            vec2(0.001),
            vec2(0.999)
        )
    );

}





float getAlpha(vec2 p)
{

    return sampleSprite(p).a;

}





// =====================
// 边缘检测
// =====================

float edgeDetect(vec2 p)
{

    float c = getAlpha(p);


    float l =
        getAlpha(
            p + vec2(-outlineWidth,0)
        );


    float r =
        getAlpha(
            p + vec2(outlineWidth,0)
        );


    float t =
        getAlpha(
            p + vec2(0,outlineWidth)
        );


    float b =
        getAlpha(
            p + vec2(0,-outlineWidth)
        );



    float edge =
        abs(c-l)
        +
        abs(c-r)
        +
        abs(c-t)
        +
        abs(c-b);



    return clamp(
        edge * edgeStrength,
        0.0,
        1.0
    );

}





// =====================
// 描边
// =====================

float outlineDetect(vec2 p)
{

    float a = getAlpha(p);


    float n = 0.0;



    n = max(
        n,
        getAlpha(
            p + vec2(outlineWidth,0)
        )
    );


    n = max(
        n,
        getAlpha(
            p + vec2(-outlineWidth,0)
        )
    );


    n = max(
        n,
        getAlpha(
            p + vec2(0,outlineWidth)
        )
    );


    n = max(
        n,
        getAlpha(
            p + vec2(0,-outlineWidth)
        )
    );



    return clamp(
        n-a,
        0.0,
        1.0
    );

}





vec4 frag()
{

    vec4 col =
        sampleSprite(uv);



    if(col.a < 0.01)
    {
        discard;
    }





    // =====================
    // 图片染色
    // =====================

    col.rgb *= tintColor.rgb;






    // =====================
    // 边缘增强
    // =====================

    float edge =
        edgeDetect(uv);



    col.rgb +=
        glowColor.rgb
        *
        edge
        *
        glowStrength;






    // =====================
    // 描边
    // =====================

    float outline =
        outlineDetect(uv);



    vec3 outlineRGB =
        outlineColor.rgb
        *
        outline;



    col.rgb =
        mix(
            outlineRGB,
            col.rgb,
            col.a
        );


    col.a =
        max(
            col.a,
            outline * outlineColor.a
        );






#if USE_LOCAL

    col *= v_color;

#endif



    return col;

}

}%