CCEffect %{
  techniques:
  - name: windTransition
    passes:
    - vert: vs:vert
      frag: fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      properties:
        transitionProgress: { value: 0.0, editor: { range:[0.0,1.0,0.01] } }
        waveAmplitude: { value: 0.03, editor: { range:[0.0,0.15,0.001] } }
        waveFrequency: { value: 12.0, editor: { range:[1.0,30.0,0.1] } }
        edgeWidth: { value: 0.08, editor: { range:[0.001,0.3,0.001] } }
        effectTime: { value: 0.0 }
}%

CCProgram vs %{
precision highp float;
#include <cc-global>

#if USE_LOCAL
#include <builtin/uniforms/cc-local>
#endif

in vec3 a_position;
in vec2 a_texCoord;

out vec2 uv;

#if USE_LOCAL
in vec4 a_color;
out vec4 v_color;
#endif

vec4 vert(){

    vec4 pos = vec4(a_position,1.0);

    #if USE_LOCAL
    pos = cc_matWorld * pos;
    v_color = a_color;
    #endif

    pos = cc_matViewProj * pos;

    uv = a_texCoord;

    return pos;
}
}%

CCProgram fs %{
precision highp float;

#include <sprite-texture>
#include <cc-global>

in vec2 uv;

#if USE_LOCAL
in vec4 v_color;
#endif

uniform UBO{
    float transitionProgress;
    float waveAmplitude;
    float waveFrequency;
    float edgeWidth;

    float effectTime;
};

vec4 frag(){

    vec2 safeUV = clamp(
        uv,
        vec2(0.001),
        vec2(0.999)
    );

    float wave =
        sin(
            safeUV.y * waveFrequency +
            effectTime * 6.0
        )
        *
        waveAmplitude;

    float front =
        transitionProgress +
        wave;

    float edge =
        smoothstep(
            front - edgeWidth,
            front,
            safeUV.x
        );

    vec2 sampleUV = safeUV;

    sampleUV.x -=
        edge *
        waveAmplitude *
        2.0;

    sampleUV = clamp(
        sampleUV,
        vec2(0.001),
        vec2(0.999)
    );

    vec4 o =
        texture(
            cc_spriteTexture,
            sampleUV
        );

    float alpha =
        1.0 -
        smoothstep(
            front - edgeWidth,
            front,
            safeUV.x
        );

    o.a *= alpha;

    #if USE_LOCAL
    o *= v_color;
    #endif

    return o;
}
}%