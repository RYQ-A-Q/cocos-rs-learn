CCEffect %{
techniques:
- passes:
  - vert: vs:vert
    frag: fs:frag
    blendState:
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
    rasterizerState:
      cullMode: none
    depthStencilState:
      depthTest: false
      depthWrite: false
    properties:
      jellyOffset: { value: [0,0,0,0] }
      jellyStrength: { value: 0.0 }
}%

CCProgram vs %{
precision highp float;

#include <cc-global>

in vec3 a_position;
in vec2 a_texCoord;
in vec4 a_color;

out vec2 uv;
out vec4 v_color;

uniform UBO {
    vec4 jellyOffset;
    float jellyStrength;
};

vec4 vert () {

    vec3 pos = a_position;

    vec2 center = vec2(0.5,0.5);
    vec2 localUV = a_texCoord - center;

    float falloff = 1.0 - length(localUV);

    pos.xy += jellyOffset.xy * falloff * jellyStrength;

    uv = a_texCoord;
    v_color = a_color;

    return cc_matViewProj * vec4(pos,1.0);
}
}%

CCProgram fs %{
precision highp float;

#include <sprite-texture>

in vec2 uv;
in vec4 v_color;

vec4 frag () {

    vec4 col = texture(cc_spriteTexture, uv);

    col *= v_color;

    return col;
}
}%