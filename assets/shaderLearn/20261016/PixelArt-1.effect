
CCEffect %{
  techniques:
  - name: pixel-illustration
    passes:
    - vert: vs:vert
      frag: fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        pixelGrid: { value: [160.0, 160.0], editor: { displayName: 像素网格 } }
        pixelStrength: { value: 0.85, editor: { displayName: 像素化强度, range: [0.0, 1.0] } }
        colorLevels: { value: 8.0, editor: { displayName: 颜色色阶, range: [2.0, 16.0] } }
        edgeStrength: { value: 0.15, editor: { displayName: 边缘强化, range: [0.0, 1.0] } }
        shadowStrength: { value: 0.08, editor: { displayName: 暗部强化, range: [0.0, 1.0] } }
}%

CCProgram vs %{
precision highp float;
#include <cc-global>
#include <builtin/uniforms/cc-local>

in vec3 a_position;
in vec2 a_texCoord;
#if USE_LOCAL
in vec4 a_color;
out vec4 v_color;
#endif
out vec2 v_uv;

vec4 vert() {
    vec4 pos = vec4(a_position, 1.0);
    pos = cc_matWorld * pos;
    pos = cc_matViewProj * pos;
    v_uv = a_texCoord;
    #if USE_LOCAL
    v_color = a_color;
    #endif
    return pos;
}
}%

CCProgram fs %{
precision highp float;
#include <sprite-texture>

in vec2 v_uv;
#if USE_LOCAL
in vec4 v_color;
#endif

uniform PixelIllustrationParams {
    vec2 pixelGrid;
    float pixelStrength;
    float colorLevels;
    float edgeStrength;
    float shadowStrength;
};

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec3 quantizeColor(vec3 c, float levels) {
    levels = max(levels - 1.0, 1.0);
    return floor(c * levels + 0.5) / levels;
}

vec4 frag() {
    vec2 grid = max(pixelGrid, vec2(1.0));
    vec2 snappedUV = (floor(v_uv * grid) + 0.5) / grid;
    vec2 pixelUV = mix(v_uv, snappedUV, clamp(pixelStrength, 0.0, 1.0));

    vec4 col = texture(cc_spriteTexture, pixelUV);

    vec2 stepUV = 1.0 / grid;
    vec3 leftColor = texture(cc_spriteTexture, pixelUV - vec2(stepUV.x, 0.0)).rgb;
    vec3 rightColor = texture(cc_spriteTexture, pixelUV + vec2(stepUV.x, 0.0)).rgb;
    vec3 downColor = texture(cc_spriteTexture, pixelUV - vec2(0.0, stepUV.y)).rgb;
    vec3 upColor = texture(cc_spriteTexture, pixelUV + vec2(0.0, stepUV.y)).rgb;

    float edge = abs(getLuma(leftColor) - getLuma(rightColor));
    edge += abs(getLuma(downColor) - getLuma(upColor));
    edge = clamp(edge * 1.5, 0.0, 1.0);

    vec3 rgb = quantizeColor(col.rgb, colorLevels);
    rgb *= 1.0 - edge * clamp(edgeStrength, 0.0, 1.0);
    rgb *= 1.0 - (1.0 - getLuma(rgb)) * clamp(shadowStrength, 0.0, 1.0) * 0.15;

    #if USE_LOCAL
    rgb *= v_color.rgb;
    col.a *= v_color.a;
    #endif

    return vec4(rgb, col.a);
}
}%
