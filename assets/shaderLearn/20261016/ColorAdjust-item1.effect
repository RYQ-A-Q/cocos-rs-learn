
CCEffect %{
techniques:
  - name: color-adjust
    passes:
      - vert: vs:vert
        frag: fs:frag
        depthStencilState:
          depthTest: false
          depthWrite: false
        rasterizerState:
          cullMode: none
        blendState:
          targets:
            - blend: true
              blendSrc: src_alpha
              blendDst: one_minus_src_alpha
              blendSrcAlpha: one
              blendDstAlpha: one_minus_src_alpha
        properties:
          brightness:
            {
              value: 0.0,
              editor: { displayName: 亮度, range: [-100.0, 100.0] },
            }
          saturation:
            {
              value: 0.0,
              editor: { displayName: 饱和度, range: [-100.0, 100.0] },
            }
          contrast:
            {
              value: 0.0,
              editor: { displayName: 对比度, range: [-100.0, 100.0] },
            }
          softness:
            {
              value: 0.0,
              editor: { displayName: 柔和度, range: [-100.0, 100.0] },
            }
          hue:
            {
              value: 0.0,
              editor: { displayName: 色相偏移, range: [-100.0, 100.0] },
            }
          effectStrength:
            {
              value: 100.0,
              editor: { displayName: 效果强度, range: [0.0, 100.0] },
            }
          objectOnly:
            {
              value: 0.0,
              editor: { displayName: 仅调整物品, range: [0.0, 1.0] },
            }
          edgeProtection:
            {
              value: 50.0,
              editor: { displayName: 边缘保护, range: [0.0, 100.0] },
            }

}%

CCProgram vs %{
precision highp float;
#include <cc-global>
#include <builtin/uniforms/cc-local>

in vec3 a_position;
in vec2 a_texCoord;
#if USE_LOCAL
  in vec4 a_color;
  out vec4 v_color;
#endif
out vec2 v_uv;

vec4 vert() {
  vec4 pos = vec4(a_position, 1.0);
  pos = cc_matWorld * pos;
  pos = cc_matViewProj * pos;
  v_uv = a_texCoord;
  #if USE_LOCAL
    v_color = a_color;
  #endif
  return pos;
}
}%

CCProgram fs %{
precision highp float;
#include <sprite-texture>

in vec2 v_uv;
#if USE_LOCAL
  in vec4 v_color;
#endif

uniform ColorAdjustParams {
  float brightness;
  float saturation;
  float contrast;
  float softness;
  float hue;
  float effectStrength;
  float objectOnly;
  float edgeProtection;
};

float getLuma(vec3 c) {
  return dot(c, vec3(0.299, 0.587, 0.114));
}

float getAdjustValue(float v) {
  return clamp(v, - 100.0, 100.0) / 100.0;
}

vec3 rgbToHsv(vec3 c) {
  vec4 K = vec4(0.0, - 0.3333333333, 0.6666666667, - 1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 0.000001;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsvToRgb(vec3 c) {
  vec3 p = abs(fract(c.xxx + vec3(0.0, 0.6666666667, 0.3333333333)) * 6.0 - 3.0);
  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

vec3 adjustColor(vec3 rgb) {
  float b = getAdjustValue(brightness);
  float s = getAdjustValue(saturation);
  float c = getAdjustValue(contrast);
  float h = getAdjustValue(hue);
  
  // 亮度：0 为原始亮度 
  rgb += vec3(b * 0.5);
  
  // 饱和度：0 为原始饱和度 
  float gray = getLuma(rgb);
  rgb = mix(vec3(gray), rgb, 1.0 + s);
  
  // 对比度：0 为原始对比度 
  rgb = (rgb - 0.5) * (1.0 + c) + 0.5;
  
  // 色相：0 为原始色相 
  vec3 hsv = rgbToHsv(clamp(rgb, 0.0, 1.0));
  hsv.x = fract(hsv.x + h * 0.5);
  rgb = hsvToRgb(hsv);
  
  return clamp(rgb, 0.0, 1.0);
}

vec4 frag() {
  vec4 col = texture(cc_spriteTexture, v_uv);
  vec3 original = col.rgb;
  
  // 固定 UV 偏移的四方向柔化采样 
  vec2 texel = vec2(1.0 / 512.0);
  vec3 around = texture(cc_spriteTexture, v_uv + vec2(texel.x, 0.0)).rgb;
  around += texture(cc_spriteTexture, v_uv - vec2(texel.x, 0.0)).rgb;
  around += texture(cc_spriteTexture, v_uv + vec2(0.0, texel.y)).rgb;
  around += texture(cc_spriteTexture, v_uv - vec2(0.0, texel.y)).rgb;
  around *= 0.25;
  
  // 柔和度：负数锐化，正数柔化 
  float soft = getAdjustValue(softness);
  vec3 center = original;
  if (soft >= 0.0) {
    center = mix(original, around, soft);
  } else {
    center = clamp(original + (original - around) * (-soft), 0.0, 1.0);
  }
  
  vec3 adjusted = adjustColor(center);
  float strength = clamp(effectStrength, 0.0, 100.0) / 100.0;
  
  // 根据 Alpha 透明度计算物品遮罩 
  // 边缘保护越高，越少调整半透明边缘 
  float protection = clamp(edgeProtection, 0.0, 100.0) / 100.0;
  float alphaStart = protection * 0.5;
  float objectMask = smoothstep(alphaStart, 1.0, col.a);
  
  // 关闭时保持原有全图调整；开启时只调整不透明物品区域 
  float mask = mix(1.0, objectMask, step(0.5, objectOnly));
  col.rgb = mix(original, adjusted, strength * mask);
  
  #if USE_LOCAL
    col.rgb *= v_color.rgb;
    col.a *= v_color.a;
  #endif
  
  return col;
}
}%
