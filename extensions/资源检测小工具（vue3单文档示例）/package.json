{
  "package_version": 2,
  "name": "resource-checker",
  "version": "1.0.9",
  "type": "module",
  "description": "i18n:resource-checker.description",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vue-flow/core": "^1.28.0",
    "fs-extra": "^10.0.0",
    "heapsnapshot-parser": "^0.1.0",
    "image-size": "^1.0.2",
    "vue": "^3.3.4",
    "vue3-virtual-list": "^1.0.2",
    "xml2js": "^0.6.2",
    "xml2js-xpath": "^0.13.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.5",
    "@types/node": "^20.4.6",
    "@vitejs/plugin-vue": "^4.2.3",
    "sass": "^1.66.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vue-tsc": "^1.8.5"
  },
  "panels": {
    "default": {
      "title": "Image Checker",
      "type": "dockable",
      "main": "dist/panels/default",
      "size": {
        "min-width": 300,
        "min-height": 300,
        "width": 300,
        "height": 600
      }
    },
    "heap": {
      "title": "Heap Checker",
      "type": "dockable",
      "main": "dist/panels/heap",
      "size": {
        "min-width": 300,
        "min-height": 300,
        "width": 300,
        "height": 600
      }
    },
    "bundles": {
      "title": "ResRelation Checker",
      "type": "dockable",
      "main": "dist/panels/bundle",
      "size": {
        "min-width": 300,
        "min-height": 300,
        "width": 300,
        "height": 600
      }
    },
    "fgui": {
      "title": "FairyGUI Checker",
      "type": "dockable",
      "main": "dist/panels/fgui",
      "size": {
        "min-width": 300,
        "min-height": 300,
        "width": 300,
        "height": 600
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "Tools/ResourceChecker",
        "label": "ImageChecker",
        "message": "open-panel"
      },
      {
        "path": "Tools/ResourceChecker",
        "label": "HeapChecker",
        "message": "open-heap-panel"
      },
      {
        "path": "Tools/ResourceChecker",
        "label": "ResRelationChecker",
        "message": "open-bundle-panel"
      },
      {
        "path": "Tools/ResourceChecker",
        "label": "FairyGUIChecker",
        "message": "open-fgui-panel"
      }
    ],
    "inspector": {
      "section": {
        "node": {
          "TestComp": "./dist/inspector/test-comp.js"
        }
      }
    },
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "open-heap-panel": {
        "methods": [
          "openHeapPanel"
        ]
      },
      "open-bundle-panel": {
        "methods": [
          "openBundlePanel"
        ]
      },
      "open-fgui-panel": {
        "methods": [
          "openFguiPanel"
        ]
      },
      "send-to-panel": {
        "methods": [
          "default.hello"
        ]
      },
      "set-current-uuid": {
        "methods": [
          "bundles.setCurrentUuid"
        ]
      }
    },
    "assets": {
      "menu": {
        "methods": "./dist/assetMenu.js",
        "createMenu": "onCreateMenu",
        "assetMenu": "onAssetMenu",
        "dbMenu": "onDBMenu",
        "panelMenu": "onPanelMenu"
      }
    }
  },
  "author": "Cocos Creator",
  "editor": ">=3.4.0",
  "_storeId": "f94416d3f6e361de9e3d36660e1e1d5c"
}
